    "src/renderer/src/data/ports/index.ts",
    "src/renderer/src/utils/version.ts",
    "src/renderer/src/components/plugin-store/panel/tabs/config-value.ts",
    "src/main/registry/resolve/index.ts",
    "src/main/registry/resolve/verify.ts",
