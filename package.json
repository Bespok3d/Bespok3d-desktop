{
  "name": "bespok3d",
  "version": "0.7.7-beta",
  "description": "Plugin manager for Klipper 3D printers",
  "main": "./out/main/index.js",
  "author": "unlucio",
  "scripts": {
    "predev": "sh ./scripts/name-dev-electron-bundle.sh; sh ./scripts/pack-plugins.sh || true",
    "dev": "electron-vite dev",
    "prebuild": "sh ./scripts/pack-plugins.sh",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "typecheck:node": "tsc -b tsconfig.node.json",
    "typecheck:web": "tsc -b tsconfig.web.json",
    "release": "bash ./scripts/release.sh",
    "package": "node scripts/package-app.mjs live",
    "package:dev": "node scripts/package-app.mjs development",
    "package:staging": "node scripts/package-app.mjs staging",
    "package:live": "node scripts/package-app.mjs live",
    "package:mac": "node scripts/package-app.mjs live --mac",
    "package:win": "node scripts/package-app.mjs live --win --x64",
    "package:linux": "node scripts/package-app.mjs live --linux",
    "package:flatpak": "node scripts/package-app.mjs live --linux flatpak",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "lint": "eslint src/ tests/ e2e/",
    "lint:fix": "eslint src/ tests/ e2e/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:invitro": "vitest run --config vitest.invitro.config.ts",
    "test:e2e": "playwright test",
    "mutation": "stryker run",
    "knip": "knip --include files,exports,types",
    "catalog": "ladle serve",
    "catalog:build": "ladle build",
    "inventory": "node ./scripts/component-inventory.mjs",
    "golden:refresh": "node ./scripts/refresh-monorepo-golden.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/ssh2": "^1.15.5",
    "adm-zip": "^0.6.1",
    "bonjour-service": "^1.4.0",
    "electron-updater": "^6.8.9",
    "openpgp": "^6.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.8.0",
    "jscpd": "5.0.9",
    "jsdom": "^25.0.1",
    "knip": "^5.88.1",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "electron@43.4.1": true
  }
}
